# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=stravaxeng
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# From strava.com/settings/api. Tokens are not kept here: run
# `python manage.py get_strava_token`, which saves them to the database.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Your local time zone (IANA name), used for dates, streaks and weekly charts
TIME_ZONE=Africa/Johannesburg
